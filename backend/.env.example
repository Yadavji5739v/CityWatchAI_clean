# Supabase keys are used only by optional integrations that still depend on Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Complaint persistence and assignment records use Supabase PostgreSQL.
# In Render, use the Supabase transaction-pooler connection string (port 6543).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_MAX=8
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=your-supabase-database-password
SUPABASE_DB_SCHEMA=citywatch
SUPABASE_STORAGE_BUCKET=evidence

# Set to a random value of at least 32 characters in production. SECRET_KEY is preferred.
SECRET_KEY=
CITYWATCH_JWT_SECRET=
ENVIRONMENT=development
CORS_ORIGINS=
CITYWATCH_AUTO_MIGRATE=true
CITYWATCH_SEED_DEMO_ACCOUNTS=true
CITYWATCH_IMPORT_LEGACY_SQLITE=false
CITYWATCH_ROAD_MODEL_PATH=models/road_damage_5class_model.keras

# Keep private keys and passwords only in backend/.env. Never expose them in React.
