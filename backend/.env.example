# Supabase keys are used only by optional integrations that still depend on Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Complaint persistence and assignment records use local MySQL.
CITYWATCH_DB_HOST=127.0.0.1
CITYWATCH_DB_PORT=3306
CITYWATCH_DB_USER=your_mysql_username
CITYWATCH_DB_PASSWORD=your_mysql_password
CITYWATCH_DB_NAME=citywatch_ai

# Optional: set a long random value. Local development generates and persists one
# under backend/data/.jwt_secret when this is omitted.
CITYWATCH_JWT_SECRET=

# Keep private keys and passwords only in backend/.env. Never expose them in React.
